<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
  <FontFamily x:Key="NumFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

  <Color x:Key="AppBackgroundColor">#242424</Color>
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#242424"/>
  <SolidColorBrush x:Key="LayerBrush" Color="#303030"/>
  <SolidColorBrush x:Key="LayerAltBrush" Color="#383838"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#17FFFFFF"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="GridLineBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="GridBoldBrush" Color="#42FFFFFF"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4E4E4"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A"/>

  <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AD4FF"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#003D6B"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A60CDFF"/>

  <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#16FFFFFF"/>
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF"/>

  <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4"/>
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1FFF99A4"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#FCE100"/>

  <SolidColorBrush x:Key="GivenBrush" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="UserBrush" Color="#8ECAE6"/>
  <SolidColorBrush x:Key="PeerBrush" Color="#1260CDFF"/>
  <SolidColorBrush x:Key="SameBrush" Color="#2960CDFF"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#3860CDFF"/>
  <SolidColorBrush x:Key="NoteBrush" Color="#A0A0A0"/>
  <SolidColorBrush x:Key="OverlayBrush" Color="#B8242424"/>

</ResourceDictionary>