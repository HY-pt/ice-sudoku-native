<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
  <FontFamily x:Key="NumFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

  <Color x:Key="AppBackgroundColor">#000000</Color>
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="MicaTintBrush" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="LayerBrush" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="LayerAltBrush" Color="{x:Static SystemColors.WindowColor}"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="DividerBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="GridLineBrush" Color="{x:Static SystemColors.WindowTextColor}" Opacity="0.55"/>
  <SolidColorBrush x:Key="GridBoldBrush" Color="{x:Static SystemColors.WindowTextColor}"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{x:Static SystemColors.WindowTextColor}"/>

  <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.85"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.7"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.25"/>

  <SolidColorBrush x:Key="ControlFillBrush" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{x:Static SystemColors.ControlLightColor}"/>
  <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{x:Static SystemColors.ControlDarkColor}"/>
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="{x:Static SystemColors.ControlColor}"/>

  <SolidColorBrush x:Key="FocusOuterBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="FocusInnerBrush" Color="{x:Static SystemColors.WindowColor}"/>

  <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="{x:Static SystemColors.ControlDarkColor}" Opacity="0.4"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{x:Static SystemColors.ControlColor}"/>
  <SolidColorBrush x:Key="WarnBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="WarnSubtleBrush" Color="{x:Static SystemColors.ControlColor}"/>

  <SolidColorBrush x:Key="GivenBrush" Color="{x:Static SystemColors.WindowTextColor}"/>
  <SolidColorBrush x:Key="UserBrush" Color="{x:Static SystemColors.HighlightColor}"/>
  <SolidColorBrush x:Key="PeerBrush" Color="{x:Static SystemColors.ControlColor}" Opacity="0.6"/>
  <SolidColorBrush x:Key="SameBrush" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.25"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.4"/>
  <SolidColorBrush x:Key="NoteBrush" Color="{x:Static SystemColors.GrayTextColor}"/>
  <SolidColorBrush x:Key="DraftBrush" Color="{x:Static SystemColors.GrayTextColor}"/>
  <SolidColorBrush x:Key="OverlayBrush" Color="{x:Static SystemColors.WindowColor}" Opacity="0.94"/>

</ResourceDictionary>