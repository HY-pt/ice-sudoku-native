<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
  <FontFamily x:Key="NumFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

  <Color x:Key="AppBackgroundColor">#F3F3F3</Color>
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="MicaTintBrush" Color="#E6F3F3F3"/>
  <SolidColorBrush x:Key="LayerBrush" Color="#FBFBFB"/>
  <SolidColorBrush x:Key="LayerAltBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#14000000"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#12000000"/>
  <SolidColorBrush x:Key="GridLineBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="GridBoldBrush" Color="#4D000000"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D5D5D"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6A6A6A"/>

  <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#0053A6"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#004884"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#14005FB8"/>

  <SolidColorBrush x:Key="ControlFillBrush" Color="#B3FFFFFF"/>
  <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#D9F9F9F9"/>
  <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0A000000"/>

  <SolidColorBrush x:Key="FocusOuterBrush" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="FocusInnerBrush" Color="#FFFFFF"/>

  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="DangerSubtleBrush" Color="#14C42B1C"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#140F7B0F"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="WarnSubtleBrush" Color="#149D5D00"/>

  <SolidColorBrush x:Key="GivenBrush" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="UserBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="PeerBrush" Color="#0D005FB8"/>
  <SolidColorBrush x:Key="SameBrush" Color="#1F005FB8"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#29005FB8"/>
  <SolidColorBrush x:Key="NoteBrush" Color="#6A6A6A"/>
  <SolidColorBrush x:Key="OverlayBrush" Color="#B8F3F3F3"/>

</ResourceDictionary>