<Window x:Class="IceSudoku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ice·sudoku" Width="660" Height="940" MinWidth="620" MinHeight="860"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFont}" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                  GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 沉浸式标题栏 -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Image Source="Assets/app.ico" Width="22" Height="22"/>
        <TextBlock Text="ice·sudoku" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="LayoutToggle" Style="{StaticResource CaptionButton}" Click="LayoutToggle_Click" ToolTip="切换横竖布局">
          <Grid Width="18" Height="18">
            <Path Data="M3,4 L13,4 L13,20 L3,20 Z M16,4 L21,4 L21,20 L16,20 Z"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Fill="Transparent"
                  Stretch="Uniform" StrokeLineJoin="Round"/>
          </Grid>
        </Button>
        <Button x:Name="ThemeToggle" Style="{StaticResource CaptionButton}" Click="ThemeToggle_Click" ToolTip="切换明暗主题">
          <Grid Width="18" Height="18">
            <Path x:Name="MoonIcon" Data="M21,12.8 A9,9 0 1 1 11.2,3 A7,7 0 0 0 21,12.8 Z"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent"
                  Stretch="Uniform" StrokeLineJoin="Round"/>
            <Path x:Name="SunIcon" Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M12,2 L12,4 M12,20 L12,22 M4,12 L2,12 M22,12 L20,12 M5,5 L6.5,6.5 M17.5,17.5 L19,19 M5,19 L6.5,17.5 M17.5,6.5 L19,5"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent"
                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
          </Grid>
        </Button>
        <Button x:Name="MinBtn" Style="{StaticResource CaptionButton}" Content="─" Click="Minimize_Click" ToolTip="最小化"/>
        <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="□" Click="Maximize_Click" ToolTip="最大化"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click" ToolTip="关闭"/>
      </StackPanel>
    </Grid>

    <!-- 主菜单 / 启动页 -->
    <Grid x:Name="HomePanel" Grid.Row="1">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Image Source="Assets/home.png" Width="360" Height="360" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="ice·sudoku" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,4"/>
        <TextBlock Text="Fluent 数独 · 离线绿色版" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="StartBtn" Style="{StaticResource AccentButton}" Content="开始游戏" Padding="34,12"
                  FontSize="16" Margin="0,0,12,0" Click="StartGame_Click"/>
          <Button x:Name="ExitGameBtn" Style="{StaticResource FluentButton}" Content="退出游戏" Padding="34,12"
                  FontSize="16" Click="ExitGame_Click"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- 游戏页 -->
    <Grid x:Name="GamePanel" Grid.Row="1" Visibility="Collapsed">
      <!-- 竖版：棋盘在上，数字盘在下 -->
      <Grid x:Name="VRoot" HorizontalAlignment="Center" Width="540" Margin="0,8,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="StatsHost" Grid.Row="0" Margin="0,0,0,14">
          <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="18,8" HorizontalAlignment="Center">
            <UniformGrid Columns="3">
              <StackPanel Width="88" HorizontalAlignment="Center">
                <TextBlock Text="用时" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TimerText" Text="00:00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Width="88" HorizontalAlignment="Center">
                <TextBlock Text="重来" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RestartText" Text="0 / 3" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Width="88" HorizontalAlignment="Center">
                <TextBlock Text="难度" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DiffText" Text="中等" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </UniformGrid>
          </Border>
          <Button x:Name="PauseBtn" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                  ToolTip="暂停 (Esc)" Click="Pause_Click">
            <Path Data="M8,5 L8,19 M16,5 L16,19" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2.4"
                  Stretch="Uniform" Width="16" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </Grid>

        <Grid x:Name="BoardHost" Grid.Row="1" Margin="0,0,0,14">
          <Border x:Name="BoardBorder" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="540" Height="540" MaxWidth="540" MaxHeight="540"
                  Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource GridBoldBrush}"
                  BorderThickness="2" CornerRadius="8" ClipToBounds="True">
            <Grid x:Name="BoardGrid"/>
          </Border>
          <Border x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="540" Height="540" Background="{DynamicResource OverlayBrush}" CornerRadius="8"
                  Visibility="Collapsed">
            <Border Background="{DynamicResource LayerAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="OverlayEmoji" Text="🎉" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="OverlayTitle" Text="完成！" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="OverlayText" Text="漂亮，全部填对了。" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" MaxWidth="320" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button x:Name="OverlayNew" Style="{StaticResource AccentButton}" Content="再来一局" Padding="20,9" Margin="0,0,8,0" Click="OverlayNew_Click"/>
                  <Button x:Name="OverlayDismiss" Style="{StaticResource FluentButton}" Content="查看棋盘" Padding="20,9" Click="OverlayDismiss_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>
        </Grid>

        <UniformGrid x:Name="NumpadGrid" Grid.Row="2" Columns="9" Rows="1" Margin="0,0,0,12"/>

        <UniformGrid x:Name="ActionsHost" Grid.Row="3" Columns="6" Rows="1" Margin="0,0,0,12">
          <ToggleButton x:Name="NotesToggle" Style="{StaticResource ToggleButton}" Content="✏ 草稿" Padding="6,8" Margin="2,0" Checked="NotesToggle_Changed" Unchecked="NotesToggle_Changed"/>
          <Button x:Name="EraseBtn" Style="{StaticResource FluentButton}" Content="⌫ 擦除" Padding="6,8" Margin="2,0" Click="Erase_Click"/>
          <Button x:Name="HintBtn" Style="{StaticResource FluentButton}" Content="💡 提示" Padding="6,8" Margin="2,0" Click="Hint_Click"/>
          <Button x:Name="CheckBtn" Style="{StaticResource FluentButton}" Content="✔ 检查" Padding="6,8" Margin="2,0" Click="Check_Click"/>
          <Button x:Name="RestartBtn" Style="{StaticResource FluentButton}" Content="↺ 重来" Padding="6,8" Margin="2,0" Click="Restart_Click"/>
          <Button x:Name="SolveBtn" Style="{StaticResource FluentButton}" Content="⚡ 自动解" Padding="6,8" Margin="2,0" Click="Solve_Click"/>
        </UniformGrid>

        <Border x:Name="HintBar" Grid.Row="4" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" MinHeight="44" Margin="0,0,0,10">
          <TextBlock x:Name="HintText" Text="" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>

        <TextBlock x:Name="FooterText" Grid.Row="5" Text="键盘：方向键移动 · 1-9 填数 · 0/Del 擦除 · N 草稿 · Esc 暂停" FontSize="12"
                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
      </Grid>

      <!-- 横版：顶部统计居中+暂停居右，下方棋盘在左、数字盘在右 -->
      <Grid x:Name="HRoot" Visibility="Collapsed" Margin="22,8,22,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="HTop" Grid.Row="0"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="HBoard" Grid.Column="0" VerticalAlignment="Center"/>
          <Grid x:Name="HSide" Grid.Column="1" Height="540" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
          </Grid>
        </Grid>
      </Grid>

      <!-- 暂停页 -->
      <Grid x:Name="PauseOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
        <Border Background="{DynamicResource LayerAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Center" MinWidth="320">
            <TextBlock Text="⏸ 已暂停" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="难度仅在此处调整，开始新游戏时生效" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="6" HorizontalAlignment="Center" Margin="0,0,0,22">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PDiffEasy" Style="{StaticResource ChipRadio}" GroupName="PauseDiff" Content="简单" Tag="easy" Checked="PauseDiff_Checked"/>
                <RadioButton x:Name="PDiffMedium" Style="{StaticResource ChipRadio}" GroupName="PauseDiff" Content="中等" Tag="medium" Checked="PauseDiff_Checked"/>
                <RadioButton x:Name="PDiffHard" Style="{StaticResource ChipRadio}" GroupName="PauseDiff" Content="困难" Tag="hard" Checked="PauseDiff_Checked"/>
                <RadioButton x:Name="PDiffExpert" Style="{StaticResource ChipRadio}" GroupName="PauseDiff" Content="专家" Tag="expert" Checked="PauseDiff_Checked"/>
              </StackPanel>
            </Border>
            <Button x:Name="ResumeBtn" Style="{StaticResource AccentButton}" Content="继续游戏" Padding="20,10" Margin="0,0,0,10" Click="Resume_Click"/>
            <Button x:Name="PauseNewBtn" Style="{StaticResource FluentButton}" Content="开始新游戏" Padding="20,10" Margin="0,0,0,10" Click="PauseNew_Click"/>
            <Button x:Name="MenuBtn" Style="{StaticResource FluentButton}" Content="返回主菜单" Padding="20,10" Click="Menu_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>